# Copy to .env for local runs:  cp .env.example .env  (never commit .env)
# In GitHub Actions these live in repo Settings -> Secrets and variables -> Actions.

# --- Gmail send (required to actually email) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
DIGEST_TO=you@example.com

# --- Optional job-search APIs (sources skip themselves if unset) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_EMAIL=
